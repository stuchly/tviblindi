#!/bin/sh

OS=$(uname)

echo "checking for OpenMP (libomp) support..."

if [ "$OS" = "Darwin" ]; then
  # Prefer whatever the active build environment already provides (covers
  # conda builds, where llvm-openmp is a build/host dependency installing
  # into $PREFIX/$BUILD_PREFIX) before falling back to common Homebrew
  # install locations for a direct, non-conda install as documented in
  # tviblindi/README.md. Conda's llvm-openmp only ships libomp.dylib (no
  # static .a), so both extensions are accepted.
  LIBOMP_CANDIDATES="
    ${PREFIX}/lib/libomp.dylib
    ${PREFIX}/lib/libomp.a
    ${BUILD_PREFIX}/lib/libomp.dylib
    ${BUILD_PREFIX}/lib/libomp.a
    /opt/homebrew/opt/libomp/lib/libomp.a
    /opt/homebrew/opt/libomp/lib/libomp.dylib
    /usr/local/opt/libomp/lib/libomp.a
    /usr/local/opt/libomp/lib/libomp.dylib
  "
  FOUND=""
  for candidate in $LIBOMP_CANDIDATES; do
    if [ -n "$candidate" ] && [ -f "$candidate" ]; then
      FOUND="$candidate"
      break
    fi
  done

  if [ -z "$FOUND" ]; then
    echo ""
    echo "ERROR: libomp not found in any of:"
    for candidate in $LIBOMP_CANDIDATES; do
      [ -n "$candidate" ] && echo "  $candidate"
    done
    echo ""
    echo "If building directly (not via conda), install it with: brew install libomp"
    echo "If building via the conda recipe, ensure llvm-openmp is a build/host dependency."
    echo ""
    exit 1
  else
    echo "  found: $FOUND"
  fi
else
  echo "  not a macOS system — skipping libomp check"
fi

exit 0
